# Dependency directories
node_modules/

# Build output
dist/

# Kuromoji dict (generated — copied from node_modules)
public/dict/*.dat
public/dict/*.trie
public/dict/*.json
public/dict/*.gz

# JMdict (large files — download separately via scripts/download-jmdict.mjs)
src/assets/jmdict/jmdict-en.json
src/assets/jmdict/*.tgz
src/assets/jmdict/*.gz
public/assets/jmdict/jmdict-en.json

# KANJIDIC2 (download separately via scripts/download-kanjidic.mjs)
src/assets/kanjidic/kanjidic2-en.json
src/assets/kanjidic/*.tgz
src/assets/kanjidic/*.gz
public/assets/kanjidic/kanjidic2-compact.json

# Pitch accent dict (download separately via scripts/download-pitch-accent.mjs)
src/assets/pitch-accent/pitch-accent.json
public/assets/pitch-accent/pitch-accent.json

# Coverage & mutation reports
coverage/
reports/

